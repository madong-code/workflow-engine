{
    "name": "madong/workflow",
    "description": "Ingenious v3 workflow engine - parse designer JSON definitions and drive process execution",
    "keywords": ["ingenious", "workflow", "madong"],
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Mr.April"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "php-di/php-di": "^7.0",
        "madong/helper": "^1.0",
        "monolog/monolog": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "madong\\workflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "madong\\workflow\\tests\\": "tests/"
        }
    }
}
