# madong/workflow demo · 数据库连接配置示例
#
# 使用方式（二选一）：
#   1. 复制本文件为 demo/config/.env 并按需修改；
#   2. 或直接设置 WF_DEMO_DB_* 环境变量（优先级高于 .env 文件）。
#
# 未提供任何配置时使用内置默认值：
#   127.0.0.1:3306 / root / root / 库名 madong_demo

WF_DEMO_DB_HOST=127.0.0.1
WF_DEMO_DB_PORT=3306
WF_DEMO_DB_NAME=madong_demo
WF_DEMO_DB_USER=root
WF_DEMO_DB_PASS=root
